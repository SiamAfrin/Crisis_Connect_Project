# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Legacy Supabase anon key. Supported as a fallback when the publishable key
# above is not set. Use only one of the two public key variables.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ and never import it into a
# client component. It is reserved for privileged server operations in later
# chunks.
SUPABASE_SERVICE_ROLE_KEY=
